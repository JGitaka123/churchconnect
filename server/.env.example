# Church 2.0 API - copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=production
PORT=4000

# PostgreSQL - either DATABASE_URL, or the discrete PG* vars below.
# DATABASE_URL=postgres://church2:STRONG_PASSWORD@db:5432/church2
PGHOST=db
PGPORT=5432
PGUSER=church2
PGPASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
PGDATABASE=church2
# PGSSL=require   # set when the DB is remote/managed and requires TLS

# Auth - generate a long random secret: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# Security hardening
# How long a signed-in session stays alive server-side (revocable sessions).
SESSION_TTL=30d
# Failed password attempts before the account is locked, and the lock duration.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MS=900000
# Minimum password length for registration / password changes.
PASSWORD_MIN_LENGTH=8
# Issuer label shown in authenticator apps (TOTP otpauth URI).
MFA_ISSUER=ChurchConnect
# DEV ONLY: force the debugCode path (codes printed to the server log instead of
# delivered) even when an email/SMS provider is configured. Keeps local tests
# deterministic and offline. NEVER set this in production.
# MFA_DEV_DEBUG=1

# MFA delivery - REAL one-time codes. Pick an email provider and/or an SMS provider.
#
# EMAIL_PROVIDER selects which service sends the mail (resend | brevo | sendgrid):
# EMAIL (Resend - https://resend.com):
#   1. Sign up, create an API key (Dashboard -> API Keys), and verify a domain.
#   2. Set EMAIL_API_KEY and EMAIL_FROM to a verified sender:
#      EMAIL_PROVIDER=resend   (default when unset)
EMAIL_API_KEY=re_YOUR_RESEND_API_KEY
#   Brevo (https://brevo.com) or SendGrid (https://sendgrid.com) need NO domain
#   DNS records - they email a "verify sender" link to your EMAIL_FROM address;
#   click it once and sending is live. Free tiers: 300/day (Brevo), 100/day (SG).
#      EMAIL_PROVIDER=brevo     EMAIL_API_KEY=xkeysib-...   (API -> API keys)
#      EMAIL_PROVIDER=sendgrid  EMAIL_API_KEY=SG.xxxx       (Settings -> API keys)
# Sender name shown on the code emails - use your church's name so recipients
# instantly recognize it. Defaults to "Church Connect" when unset.
EMAIL_FROM_NAME=Church Connect
EMAIL_FROM=Church Connect <no-reply@yourchurch.org>
#   (Optional override for a Resend-style JSON API gateway.)
# EMAIL_API_URL=https://api.resend.com/emails
#
# SMS (Africa's Talking - https://africastalking.com, common in Kenya):
#   1. Create an account, note your username, and copy the sandbox/live API key.
#   2. For live delivery buy SMS credit; for testing keep sandbox (codes logged).
SMS_USERNAME=YOUR_AFRICASTALKING_USERNAME
SMS_API_KEY=YOUR_AFRICASTALKING_API_KEY
#   (Optional: sender id / short code approved for your account.)
SMS_FROM=Church Connect
#   (Optional override for a custom JSON SMS gateway: {from,to,message}.)
# SMS_API_URL=https://api.example.com/sms/send
#
# If neither provider is configured: development logs the code and returns it as
# debugCode so the flow stays testable; production FAILS CLOSED (no code sent).

# Comma-separated allowed origins - your Vercel frontend URL(s)
CORS_ORIGINS=https://your-app.vercel.app

# Password used when seeding demo accounts
SEED_PASSWORD=grace

# AI assistant (optional) - powers the chat bot when set. Get a key from
# https://platform.deepseek.com. Without it the app uses built-in replies.
DEEPSEEK_API_KEY=sk_YOUR_DEEPSEEK_API_KEY


# ---- M-Pesa (Safaricom Daraja) - STK Push giving ---------------------------
# Credentials live in https://developer.safaricom.co.ke -> My Apps. NEVER commit
# the real values; the real server/.env is gitignored.
# MPESA_ENV=sandbox|production        (start in sandbox; switch only when the
#                                      church is approved for live payments)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
# PayBill/Till that receives the money. Sandbox demo shortcode is 174379.
MPESA_SHORTCODE=174379
# Lipa Na M-Pesa passkey for the shortcode (Daraja portal -> M-PESA API -> sandbox).
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
# Public HTTPS URL that receives Safaricom's payment result. For local testing,
# expose port 4000 with cloudflared/ngrok first, e.g.:
#   MPESA_CALLBACK_URL=https://church-yourname.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
# PayBill account name shown on the STK prompt (fallback account reference).
MPESA_ACCOUNT_REF=CHURCH

# ---- WhatsApp (announcements) - pick ONE --------------------------------
# Option 1 - Meta WhatsApp Cloud API (free tier, direct from Meta):
#   1. https://business.facebook.com -> create/use a Business Portfolio.
#   2. Add the WhatsApp product, register a Business Account + the church
#      number, then generate a System User access token with whatsapp_business_messaging.
#   3. Copy the WhatsApp Phone Number ID and the token below.
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
# Option 2 - BSP gateway (e.g. 360dialog) that exposes a JSON API:
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM=
# NOTE: WhatsApp business messages need either an approved template, or the
# member must have messaged the church first (24-hour session window).
