# Church 2.0 deploy stack (Contabo) - copy to deploy/.env and fill in.
# These feed both the db and api containers via docker-compose.

# --- Database ---
PGUSER=church2
PGPASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
PGDATABASE=church2

# --- API ---
NODE_ENV=production
PORT=4000
# Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# MFA delivery - REAL one-time codes.
# EMAIL (Resend): set EMAIL_API_KEY + a verified EMAIL_FROM. https://resend.com
EMAIL_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=Church 2.0 <no-reply@yourchurch.org>
# SMS (Africa's Talking): username + API key. https://africastalking.com
SMS_USERNAME=YOUR_AFRICASTALKING_USERNAME
SMS_API_KEY=YOUR_AFRICASTALKING_API_KEY
SMS_FROM=Church2
# Production fails closed if a selected method has no provider configured.

# Your Vercel frontend origin(s), comma-separated
CORS_ORIGINS=https://your-app.vercel.app

# Seed password for demo accounts (first-time seed only)
SEED_PASSWORD=grace
